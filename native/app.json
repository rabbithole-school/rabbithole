{
  "expo": {
    "name": "Rabbithole",
    "slug": "rabbithole",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "rabbithole",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/ios-icon-light.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "bundleIdentifier": "org.rabbithole.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Rabbithole",
        "LSApplicationQueriesSchemes": [
          "googlesheets",
          "spike"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#222656",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#222656",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "./plugins/withIpadOnly",
      "./plugins/withExternalDisplay",
      [
        "expo-audio",
        {
          "microphonePermission": "Rabbithole uses the microphone so you can talk to your tutor instead of typing."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rabbithole lets you add photos and videos to your work.",
          "cameraPermission": "Rabbithole uses the camera so you can capture photos and videos for your work.",
          "microphonePermission": "Rabbithole uses the microphone when you record a video."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
