# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# The npm lockfile IS tracked for this Expo app (the repo root .gitignore
# globally ignores package-lock.json for the pnpm web app, but native/ is a
# separate npm project and CI's `npm ci` needs the committed lockfile).
!package-lock.json

# Expo
.expo/
.metro-cache/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# generated by `pnpm install --ignore-workspace` inside native/; not tracked on master
pnpm-lock.yaml
